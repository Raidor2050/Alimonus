# ─────────────────────────────────────────────────────────────────────────────
# Alimonus configuration. Copy to .env.local for local development and add the
# same values in Netlify → Site configuration → Environment variables.
# Leave a value empty to keep that feature off; the app still works.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (VITE_*) — bundled into the browser, so never put secrets here ──

# Supabase project (Project Settings → API). Without these, Alimonus runs in local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Internal login emails the "raiyan" / "afra" usernames map to (any address you control, or the defaults).
VITE_ALIMONUS_RAIYAN_EMAIL=raiyan@alimonus.app
VITE_ALIMONUS_AFRA_EMAIL=afra@alimonus.app

# Spotify app Client ID (developer.spotify.com/dashboard). PKCE login needs no secret in the browser.
VITE_SPOTIFY_CLIENT_ID=
# Optional: defaults to <current origin>/callback/spotify (localhost is rewritten to 127.0.0.1).
# Must exactly match a Redirect URI registered in the Spotify dashboard.
VITE_SPOTIFY_REDIRECT_URI=

# Optional browser-side YouTube Data API key. Prefer YOUTUBE_API_KEY below (kept server-side).
# If you use this one, restrict it to your site's HTTP referrers in Google Cloud.
VITE_YOUTUBE_API_KEY=

# Your public site URL, e.g. https://alimonus.netlify.app (used in docs/links only).
VITE_APP_URL=

# Force local demo mode even if Supabase is configured (true/false).
VITE_ALIMONUS_DEMO=false

# ── Netlify Functions (server-side only — never exposed to the browser) ──

# Enables Spotify catalog search before a profile connects its own account (client credentials).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key used by /api/youtube-search.
YOUTUBE_API_KEY=

# ── Local provisioning script only (npm run provision) — do NOT add to Netlify ──

SUPABASE_SERVICE_ROLE_KEY=
ALIMONUS_RAIYAN_EMAIL=raiyan@alimonus.app
ALIMONUS_AFRA_EMAIL=afra@alimonus.app
ALIMONUS_INITIAL_PASSWORD=Alimonus
